    "wma": {
      "path": "COMMON/MapServer/19",
      "title": "Wildlife Management Areas",
      "fields": ["NAME", "TYPE", "ACRES", "DATE_ESTAB", "LINK"],
      "label": "NAME",
      "search": ["NAME"],
      "health": true
    },
    "refuge": {
      "path": "COMMON/MapServer/24",
      "title": "Wildlife Refuges",
      "fields": ["NAME", "OWNER", "TYPE", "ACRES"],
      "label": "NAME",
      "search": ["NAME", "OWNER"],
      "health": true
    },
    "landsale": {
      "path": "COMMON/MapServer/29",
      "title": "State Land Office land sales with minerals reserved to the state",
      "note": "Layer 30 (Land Sale Minerals Data) holds the same 5,450 rows with tax-debtor and vendee names but returned ArcGIS error 400 on every spatial query when checked.",
      "fields": ["SALENUM", "PATENT", "ACRES", "PARISH", "TOWNSHIP", "RANGE", "NOTES"],
      "label": "SALENUM",
      "search": ["SALENUM", "PATENT", "NOTES"],
      "health": false
    },
    "parish": {
      "path": "COMMON/MapServer/11",
      "title": "Parishes",
      "fields": ["PARISH", "STCOFIPS"],
      "label": "PARISH",
      "health": false
    }
  },
  "legends": {
    "WEB_STATUS": {
      "Y": "State Claimed",
      "DC": "Claimed by the State and Adjoining Land Owner (dual claimed)",
      "JAC": "Judgment, Agreement or Compromise against State Ownership",
      "PA": "Publicly Accessible (not a claim of ownership)"
    },
    "STATECLAIM": {
      "Y": "state claims the bottom",
      "N": "state does not claim",
      "PARTIAL": "state claims part",
      "UN": "coded UN; the service publishes no legend for it",
      "NO TITLE FILE": "no title file reviewed; says nothing either way"
    },
    "USE": {
      "DUAL_CLAIMED": "Dual Claimed (enter at your own risk)",
      "RESTRICTED_ACCESS": "Restricted Access (no public access)",
      "STATE AGENCY LAND": "State Agency Land (contact agency for access policy)"
    },
    "SURF_INT": {
      "FULL_INTEREST": "state holds full surface interest",
      "PART_INTEREST": "state holds part of the surface interest",
      "NO_INTEREST": "state holds no surface interest",
      "VACANT_LAND": "vacant land"
    },
    "LEGEND": {
      "1": "located from legal description",
      "2": "located from linen maps",
      "3": "WLF agency administered"
    }
  }
}
