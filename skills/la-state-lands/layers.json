      "health": false
    },
    "claimed": {
      "path": "COMMON/MapServer/17",
      "title": "State Land Office: State Claimed Water Bodies",
      "fields": ["NAME", "WEB_STATUS", "STATECLAIM", "TITLE_ID", "PID"],
      "label": "NAME",
      "legend_field": "WEB_STATUS",
      "search": ["NAME"],
      "health": true
    },
    "waterbodies": {
      "path": "COMMON/MapServer/20",
      "title": "State Land Office: State Water Bodies (title-file index)",
