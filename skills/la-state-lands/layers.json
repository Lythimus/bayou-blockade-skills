      "fields": ["TRACT_NUM", "NOM_NUM", "SALE_DATE", "APPLICANT_NM", "PUBLICATION_NM", "TRACT_KIND",
                 "PARISH_NM", "TRACT_ACREAGE", "RECOMMENDATION"],
      "label": "TRACT_NUM",
      "search": ["TRACT_NUM", "NOM_NUM", "APPLICANT_NM", "PUBLICATION_NM", "PARISH_NM", "TRACT_KIND"],
      "health": true
    },
    "archive": {
      "path": "OMR/MapServer/2",
      "title": "OMR Tract Archive (2001-present: nominations, bids, awards)",
      "fields": ["TRACT_NUM", "NOM_NUM", "SALE_DATE", "APPLICANT_NM", "PUBLICATION_NM", "BIDDER_NM", "LEASE_NUM",
