      "label": "LABEL",
      "search": ["LABEL", "POLY_TYPE", "LAWSUIT", "RESOLVE", "REFERENCE", "COMMENTS"],
      "health": true
    },
    "tracts": {
      "path": "OMR/MapServer/1",
