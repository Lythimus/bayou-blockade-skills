      "label": "NAME",
      "legend_field": "STATECLAIM",
      "search": ["NAME", "COURTCASE", "TITLE", "FILENAME"],
      "health": true
    },
    "major": {
      "path": "COMMON/MapServer/21",
      "title": "Major Inland Water Bodies (outline only, no claim status)",
      "fields": ["NAME", "AREA_AC"],
      "label": "NAME",
      "search": ["NAME"],
      "health": false
    },
    "stateland": {
      "path": "COMMON/MapServer/18",
