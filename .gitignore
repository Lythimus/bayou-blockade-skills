# Credentials. The real file belongs at ~/.claude/bayou-credentials.md, outside this
# repo — see bayou-credentials.example.md. This is a backstop in case a copy lands here.
bayou-credentials.md

# Personal profile (nextdoor-campaign). Real file belongs at ~/.claude/bayou-profile.md,
# outside this repo — see skills/nextdoor-campaign/profile.example.md. Backstop only.
bayou-profile.md

# exec-travel-monitor watchlist. This is live case data (real companies, tail numbers,
# investigative notes) — the real file belongs at ~/.claude/bayou-exec-travel-watchlist.json,
# outside this repo — see skills/exec-travel-monitor/watchlist.example.json. Backstop only.
skills/exec-travel-monitor/watchlist.json

# exec-travel-monitor bulk-downloaded ADS-B backfill cache and cron dedupe state —
# regenerated by the skill, and the cache itself is per-investigation data.
skills/exec-travel-monitor/data/
skills/exec-travel-monitor/state.json

# Node
node_modules/

# Playwright persistent browser profiles (contain cookies/session state)
.pw-profile/

# SONRIS session cookie (live auth token, 7-day validity — never commit)
.session/

# Bulk downloaded datasets (regenerated by the skills that use them)
skills/aircraft-registry-lookup/cache/

# Local workflow notes — not for the public snapshot
.claude/PUBLISH_WORKFLOW.md

# OS cruft
.DS_Store

# Python bytecode cache
__pycache__/
