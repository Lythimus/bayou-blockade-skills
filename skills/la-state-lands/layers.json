                 "APPLICANT_NM", "LEASED_ACREAGE", "RETAINED", "PRODUCT_DECIMAL_OIL", "PRODUCT_DECIMAL_GAS",
                 "SALE_DATE", "PRICE_PER_ACRE", "PARISH_NM", "STATE_AGENCY_NM", "INSTRUMENT", "FLOATER",
                 "YEAR_NUM", "MONTH_NUM", "CD_SOURCE", "LEGEND", "HYPERLINK", "DOC_ACCESS"],
      "label": "STATE_LEAS",
      "search": ["STATE_LEAS", "ORIGINAL_LESSEE", "BIDDER_NM", "APPLICANT_NM", "PUBLICATION_NM", "PARISH_NM"],
      "health": true
    },
    "sal": {
      "path": "OMR/MapServer/15",
      "title": "OMR State Agency Leases (agency-owned land leased through the Board)",
      "fields": ["STATE_LEAS", "LEASE_NUM", "STATE_AGENCY_NM", "ORIGINAL_LESSEE", "BIDDER_NM", "LEASED_ACREAGE",
                 "SALE_DATE", "PARISH_NM", "INSTRUMENT", "YEAR_NUM", "MONTH_NUM", "HYPERLINK", "DOC_ACCESS"],
      "label": "STATE_LEAS",
      "search": ["STATE_LEAS", "ORIGINAL_LESSEE", "BIDDER_NM", "APPLICANT_NM", "STATE_AGENCY_NM", "PARISH_NM"],
      "health": true
    },
    "blease": {
      "path": "OMR/MapServer/16",
      "title": "OMR B Leases (small unleased acreage inside units)",
      "fields": ["LEASE_NUM", "ORIGINAL_LESSEE", "LEASED_ACRES", "RETAINED_ACRES", "LEASE_EFF_DATE",
                 "LEASE_DESCRIPTION", "COMMENTS", "DOC_ACCESS"],
      "label": "LEASE_NUM",
      "search": ["LEASE_NUM", "ORIGINAL_LESSEE", "COMMENTS"],
      "health": true
    },
    "legal": {
      "path": "OMR/MapServer/7",
      "title": "OMR Legal Areas (partial state interest, lawsuits, judgments, compromises)",
